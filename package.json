{
  "name": "agent-manager",
  "private": true,
  "type": "module",
  "description": "Local overview of skills across Claude Code, Codex and pi",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "test": "node --test \"server/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/index.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  }
}
